# Copy to .env for local runs (uvicorn/python-dotenv or your shell) or set
# these as real environment variables in your deployment target.

# --- Service ---
SERVICE_NAME=ASR Service
SERVICE_DESCRIPTION=Automatic Speech Recognition API
SERVICE_VERSION=1.0.0
SERVICE_ENVIRONMENT=development

# --- Server ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# --- Model ---
MODEL_NAME=mohammedaly22/QwenCleo-ASR
MODEL_DEVICE=auto          # auto | cpu | cuda
MODEL_TRUST_REMOTE_CODE=true

# --- Audio ---
AUDIO_MAX_FILE_SIZE_MB=25
AUDIO_MAX_DURATION_SEC=60
AUDIO_SAMPLE_RATE=16000

# --- Storage ---
ASR_UPLOAD_DIR=/tmp/asr_uploads

# --- Logging ---
LOG_LEVEL=INFO

# --- RabbitMQ ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_REQUESTS_QUEUE=asr.transcription.requests
RABBITMQ_RESULTS_QUEUE=asr.transcription.results
RABBITMQ_PREFETCH_COUNT=1