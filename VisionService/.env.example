# ============================================
# Service Settings
# ============================================
SERVICE_NAME=vision-service
SERVICE_VERSION=1.0.0
HOST=0.0.0.0
PORT=8001
DEBUG=true

# ============================================
# Model Settings
# ============================================
MODEL_PATH=./models/efficientnet_waha_kun.keras
BINARY_MODEL_PATH=./models/binary_classifier.keras
CONFIDENCE_THRESHOLD=75.0
BINARY_THRESHOLD=0.75

# ============================================
# File Settings
# ============================================
UPLOAD_FOLDER=./uploads
MAX_FILE_SIZE=10485760

# ============================================
# Image Processing
# ============================================
QUALITY_CHECK_ENABLED=true
ENHANCE_IMAGE_ENABLED=true

# ============================================
# RabbitMQ Settings
# ============================================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ✅ NEW: Queue Names
REQUESTS_QUEUE=vision.analysis.request
RESULTS_QUEUE=vision.analysis.result

# ✅ NEW: Image Download Timeout (seconds)
IMAGE_DOWNLOAD_TIMEOUT=30