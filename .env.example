# App Configuration
DEBUG=false
HOST=0.0.0.0
PORT=8000
APP_NAME=Arabic Comment Moderation Service
APP_VERSION=1.0.0

# Model Configuration
MODEL_PATH=moderation_service/infrastructure/model/WAHA_KUN_AraBERT
MAX_SEQUENCE_LENGTH=128
DEVICE=cpu
CONFIDENCE_THRESHOLD=0.7

# RabbitMQ Configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_QUEUE=moderation_queue
RABBITMQ_HEARTBEAT=600
RABBITMQ_TIMEOUT=300

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=text