.env.*.local
*.pem
*.key
credentials.json

# ---- Uploads & logs ----
uploads/
logs/
*.log

# ---- IDE ----
.vscode/
.idea/
*.swp
*.swo

# ---- OS ----
.DS_Store
Thumbs.db

# ---- Docker ----
*.pid
'@ | Out-File -Encoding utf8 .gitignore